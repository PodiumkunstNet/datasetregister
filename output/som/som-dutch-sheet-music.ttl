@prefix schema: <https://schema.org/> .

<https://data.podiumkunst.net/dataset/som-dutch-sheet-music> a schema:Dataset ;
    schema:creator <https://www.omroepmuziek.nl> ;
    schema:dateCreated "2017-01-01"^^schema:Date ;
    schema:dateModified "2026-03-12"^^schema:Date ;
    schema:datePublished "2017-12-31"^^schema:Date ;
    schema:description "Linked Open dataset on the sheet music contained in the collection of the Stichting Omroep Muziek and music-related persons and ensembles. This includes structured bibliographic descriptions of both published (ruleset: ISBD-PM) and unpublished, handwritten musical materials in various styles, genres and performance media. The unpublished category concerns music manuscripts that were written/arranged especially for the radio and television ensembles in the period from 1925 to the present day. Related names have been and will be standardised and published as such."@en,
        "Linked Open dataset over de bladmuziek van de Nederlandse publieke omroep en muziekgerelateerde personen en ensembles. Deze omvat gestructureerde bibliografische beschrijvingen van zowel uitgegeven (regelset: ISBD-PM) als ongepubliceerde, handgeschreven muziekmaterialen in diverse stijlen, genres en bezettingen. De ongepubliceerde categorie betreft muziekmanuscripten die speciaal voor de omroepensembles zijn geschreven/gearrangeerd en voor radio en televisie zijn uitgevoerd in de periode tussen 1925 tot nu. Hieraan gerelateerde namen zijn en worden zoveel mogelijk gestandaardiseerd en als zodanig gepubliceerd."@nl ;
    schema:distribution [ a schema:DataDownload ;
            schema:contentUrl <https://data.muziekschatten.nl/sparql> ;
            schema:dateCreated "2017-01-01"^^schema:Date ;
            schema:dateModified "2026-03-12"^^schema:Date ;
            schema:datePublished "2017-12-31"^^schema:Date ;
            schema:description "SPARQL endpoint"@en,
                "Deze data is gepubliceerd ten behoeve van de webcatalogus op muziekschatten.nl en maakt het mogelijk analoge en gedigitaliseerde muziekmaterialen te vinden en te gebruiken. Deze wordt wekelijks ververst en verrijkt."@nl ;
            schema:inLanguage "en-US",
                "nl-NL" ;
            schema:license <https://creativecommons.org/licenses/by/4.0/> ;
            schema:mainEntityOfPage <https://www.muziekschatten.nl/page/344/over> ;
            schema:name "SPARQL-endpoint"@en,
                "SPARQL-endpoint"@nl ;
            schema:usageInfo <https://www.w3.org/TR/sparql11-protocol/> ] ;
    schema:identifier "https://data.podiumkunst.net/dataset/som-dutch-sheet-music" ;
    schema:inLanguage "en-US",
        "nl-NL" ;
    schema:includedInDataCatalog <https://data.podiumkunst.net/datacatalog/som> ;
    schema:keywords "composers"@en,

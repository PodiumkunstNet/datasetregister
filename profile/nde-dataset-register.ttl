    <http://www.w3.org/ns/shacl#message> "Voeg een contactpunt toe met naam en e-mailadres. Gebruik bij voorkeur de gegevens van de afdeling die de dataset of catalogus beheert"@nl, "Add a contact point with a name and email address, preferably of the department that manages the dataset or catalogue"@en;
    <http://www.w3.org/ns/shacl#targetObjectsOf> <https://schema.org/publisher>, <https://schema.org/creator>;
    <http://www.w3.org/ns/shacl#sparql> _:df_18_194.
_:df_18_193 <https://def.nde.nl#version> "2.0";
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Violation>.
_:df_18_194 <http://www.w3.org/ns/shacl#select> "\n            PREFIX schema: <https://schema.org/>\n            SELECT $this ?path WHERE {\n                $this a schema:Organization .\n                FILTER NOT EXISTS { $this schema:contactPoint ?cp }\n                BIND(schema:contactPoint AS ?path)\n            }\n        ".
<https://def.nde.nl/dataset#OrganizationIdentifierRequiredShape> a <http://www.w3.org/ns/shacl#NodeShape>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Info>;
    <http://www.w3.org/ns/shacl#message> "Voeg een identificatie toe voor de organisatie, zoals een KvK-nummer of ISIL"@nl, "Add an identifier for the organisation, such as a Chamber of Commerce number or ISIL"@en;
    <http://www.w3.org/ns/shacl#targetObjectsOf> <https://schema.org/publisher>, <https://schema.org/creator>;
    <http://www.w3.org/ns/shacl#sparql> _:df_18_195.
_:df_18_195 <http://www.w3.org/ns/shacl#select> "\n            PREFIX schema: <https://schema.org/>\n            SELECT $this ?path WHERE {\n                $this a schema:Organization .\n                FILTER NOT EXISTS { $this schema:identifier ?id }\n                BIND(schema:identifier AS ?path)\n            }\n        ".
<https://def.nde.nl/dataset#IdentifierPropertyIDRequiredShape> a <http://www.w3.org/ns/shacl#NodeShape>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning>;
    <http://www.w3.org/ns/shacl#message> "Geef aan om welk type identifier het gaat (bijv. KvK of ISIL), naast de waarde"@nl, "Specify the type of identifier (such as ‘Chamber of Commerce’ or ‘ISIL’) in addition to the value"@en;
    <http://www.w3.org/ns/shacl#targetObjectsOf> <https://schema.org/identifier>;
    <http://www.w3.org/ns/shacl#sparql> _:df_18_196.
_:df_18_196 <http://www.w3.org/ns/shacl#select> "\n            PREFIX schema: <https://schema.org/>\n            SELECT $this ?path WHERE {\n                $this a schema:PropertyValue .\n                OPTIONAL { $this schema:propertyID ?pid }\n                FILTER (!bound(?pid) || !isURI(?pid))\n                BIND(schema:propertyID AS ?path)\n            }\n        ".
<https://def.nde.nl/dataset#IdentifierValueRequiredShape> a <http://www.w3.org/ns/shacl#NodeShape>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning>;
    <http://www.w3.org/ns/shacl#message> "Vul de waarde van de identifier in (bijv. een nummer of code)"@nl, "Enter the identifier value (such as a number or code)"@en;
    <http://www.w3.org/ns/shacl#targetObjectsOf> <https://schema.org/identifier>;
    <http://www.w3.org/ns/shacl#sparql> _:df_18_197.
_:df_18_197 <http://www.w3.org/ns/shacl#select> "\n            PREFIX schema: <https://schema.org/>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n            SELECT $this ?path WHERE {\n                $this a schema:PropertyValue .\n                OPTIONAL { $this schema:value ?v }\n                FILTER (!bound(?v) || !isLiteral(?v) || datatype(?v) != xsd:string)\n                BIND(schema:value AS ?path)\n            }\n        ".
<https://def.nde.nl/dataset#IdentifierNameStringShape> a <http://www.w3.org/ns/shacl#NodeShape>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning>;
    <http://www.w3.org/ns/shacl#message> "Gebruik een waarde van type rdf:langString en geef de taal aan (bijv. nl of en)"@nl, "Use a value of type rdf:langString and specify the language (such as nl or en)"@en;
    <http://www.w3.org/ns/shacl#targetObjectsOf> <https://schema.org/identifier>;
    <http://www.w3.org/ns/shacl#sparql> _:df_18_198.
_:df_18_198 <http://www.w3.org/ns/shacl#select> "\n            PREFIX schema: <https://schema.org/>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\n            SELECT $this ?path WHERE {\n                $this a schema:PropertyValue .\n                $this schema:name ?n .\n                FILTER (!isLiteral(?n) || (datatype(?n) != xsd:string && datatype(?n) != rdf:langString))\n                BIND(schema:name AS ?path)\n            }\n        ".
<https://def.nde.nl/dataset#IdentifierPropertyValueDescriptionShape> a <http://www.w3.org/ns/shacl#NodeShape>;

    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning>;
    <http://www.w3.org/ns/shacl#message> "Gebruik de Creative Commons-URI zelf, geen opendefinition.org-alias"@nl, "Use the Creative Commons URI directly, not an opendefinition.org alias"@en;
    <http://www.w3.org/ns/shacl#node> <https://def.nde.nl/dataset#LicenseNotOpenDefinitionShape>.
<https://def.nde.nl/dataset#LicenseNotOpenDefinitionShape> a <http://www.w3.org/ns/shacl#NodeShape>;
    <http://www.w3.org/ns/shacl#not> _:df_18_232.
_:df_18_55 <http://www.w3.org/ns/shacl#path> <https://schema.org/license>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning>;
    <http://www.w3.org/ns/shacl#message> "Gebruik de officiële Open Data Commons-licentie-URI met versienummer, bijv. http://opendatacommons.org/licenses/odbl/1.0/"@nl, "Use an official Open Data Commons licence URI with a version number, such as http://opendatacommons.org/licenses/odbl/1.0/"@en;
    <http://www.w3.org/ns/shacl#node> <https://def.nde.nl/dataset#LicenseOpenDataCommonsShape>.
<https://def.nde.nl/dataset#LicenseOpenDataCommonsShape> a <http://www.w3.org/ns/shacl#NodeShape>;
    <http://www.w3.org/ns/shacl#or> _:df_18_233.

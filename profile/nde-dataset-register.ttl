    <http://www.w3.org/ns/shacl#description> "Distributies waarmee de dataset kan worden opgehaald, bijvoorbeeld als download of via een API."@nl, "Distributions through which the dataset can be retrieved, such as as a download or via an API."@en;
    <http://www.w3.org/ns/shacl#path> <https://schema.org/distribution>;
    <http://www.w3.org/ns/shacl#minCount> 1;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Info>.
_:df_18_57 <http://www.w3.org/ns/shacl#description> "De organisatie of persoon die verantwoordelijk is voor het creëren van de beschreven dataset."@nl, "An entity (organisation or person) responsible for producing the dataset."@en;
    <https://def.nde.nl#futureChange> _:df_18_58;
    <http://www.w3.org/ns/shacl#path> <https://schema.org/creator>;
    <http://www.w3.org/ns/shacl#minCount> 1;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning>;
    <http://www.w3.org/ns/shacl#or> _:df_18_59;
    <http://www.w3.org/ns/shacl#message> "Voeg een maker toe"@nl, "Add a creator"@en.
_:df_18_58 <https://def.nde.nl#version> "2.0";
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Violation>.

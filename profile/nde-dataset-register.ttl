_:df_18_501 <https://def.nde.nl#futureChange> _:df_18_502;
    <http://www.w3.org/ns/shacl#path> <http://xmlns.com/foaf/0.1/nick>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning>;
    <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/1999/02/22-rdf-syntax-ns#langString>;
    <http://www.w3.org/ns/shacl#message> "Gebruik een waarde van type rdf:langString en geef de taal aan (bijv. nl of en)"@nl, "Use a value of type rdf:langString and specify the language (such as nl or en)"@en.
_:df_18_502 <https://def.nde.nl#version> "2.0";
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Violation>.
_:df_18_503 <http://www.w3.org/ns/shacl#description> "Identificatie(s) van de organisatie, minimaal de <a href=\"https://www.nationaalarchief.nl/archiveren/kennisbank/isil-codes\">ISIL-code</a>."@nl, "Identifier(s) of the organization, at least its <a href=\"https://www.nationaalarchief.nl/archiveren/kennisbank/isil-codes\">ISIL code</a>."@en;
    <http://www.w3.org/ns/shacl#path> <http://purl.org/dc/terms/identifier>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Warning>;
    <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#string>;
    <http://www.w3.org/ns/shacl#message> "Gebruik een waarde van type xsd:string"@nl, "Use a value of type xsd:string"@en.
_:df_18_504 <http://www.w3.org/ns/shacl#description> "Verwijzingen naar de organisatie in andere databases."@nl, "Links to the organization in other databases."@en;
    <http://www.w3.org/ns/shacl#nodeKind> <http://www.w3.org/ns/shacl#IRI>;
    <http://www.w3.org/ns/shacl#path> <http://www.w3.org/2002/07/owl#sameAs>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Info>;
    <http://www.w3.org/ns/shacl#message> "Gebruik een waarde van type URI (RDF-resource), geen tekst"@nl, "Use a value of type URI (RDF resource), not text"@en.
_:df_18_505 <http://www.w3.org/ns/shacl#path> <http://www.w3.org/2002/07/owl#sameAs>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Info>;
    <http://www.w3.org/ns/shacl#message> "Gebruik een web-URI die begint met http:// of https://"@nl, "Use a web URI starting with http:// or https://"@en;
    <http://www.w3.org/ns/shacl#pattern> "^https?://".
<http://www.w3.org/ns/dcat#OrganizationIdentifierRequiredShape> a <http://www.w3.org/ns/shacl#NodeShape>;
    <http://www.w3.org/ns/shacl#severity> <http://www.w3.org/ns/shacl#Info>;
    <http://www.w3.org/ns/shacl#message> "Voeg een identificatie toe voor de organisatie, zoals een KvK-nummer of ISIL"@nl, "Add an identifier for the organisation, such as a Chamber of Commerce number or ISIL"@en;
    <http://www.w3.org/ns/shacl#targetObjectsOf> <http://purl.org/dc/terms/publisher>, <http://purl.org/dc/terms/creator>;
    <http://www.w3.org/ns/shacl#sparql> _:df_18_506.
_:df_18_506 <http://www.w3.org/ns/shacl#select> "\n            PREFIX dct: <http://purl.org/dc/terms/>\n            PREFIX foaf: <http://xmlns.com/foaf/0.1/>\n            SELECT $this ?path WHERE {\n                $this a foaf:Organization .\n                FILTER NOT EXISTS { $this dct:identifier ?id }\n                BIND(dct:identifier AS ?path)\n            }\n        ".
<https://def.nde.nl/probe#DistributionReachableConstraintComponent> a <http://www.w3.org/ns/shacl#ConstraintComponent>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Distribution reachability check"@en, "Distributie-bereikbaarheidscontrole"@nl;
    <http://www.w3.org/2000/01/rdf-schema#comment> "\n        Asserts that the IRI value at the annotated property path responds successfully to\n        an HTTP probe. Activated on a property shape by setting nde-probe:probeReachable true.\n    "@en;
    <http://www.w3.org/ns/shacl#parameter> _:df_18_507.
_:df_18_507 <http://www.w3.org/ns/shacl#path> <https://def.nde.nl/probe#probeReachable>;
    <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#boolean>.
<https://def.nde.nl/probe#DistributionFormatMatchConstraintComponent> a <http://www.w3.org/ns/shacl#ConstraintComponent>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Distribution format match check"@en, "Distributie-formaatcontrole"@nl;
    <http://www.w3.org/2000/01/rdf-schema#comment> "\n        Asserts that the HTTP Content-Type returned by the probed URL is compatible with\n        the declared dcat:mediaType (or schema:encodingFormat). Activated on a property\n        shape by setting nde-probe:probeFormatMatch true.\n    "@en;
    <http://www.w3.org/ns/shacl#parameter> _:df_18_508.
_:df_18_508 <http://www.w3.org/ns/shacl#path> <https://def.nde.nl/probe#probeFormatMatch>;
    <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#boolean>.
<https://def.nde.nl/probe#ProbeOutcome> a <http://www.w3.org/2000/01/rdf-schema#Class>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Distribution probe outcome"@en, "Uitkomst distributiecontrole"@nl.
<https://def.nde.nl/probe#NetworkError> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Network error before any HTTP response"@en, "Netwerkfout voor enige HTTP-respons"@nl.
<https://def.nde.nl/probe#NotFound> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "HTTP 404 Not Found"@en, "HTTP 404 niet gevonden"@nl.
<https://def.nde.nl/probe#ServerError> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "HTTP 5xx server error"@en, "HTTP 5xx-serverfout"@nl.
<https://def.nde.nl/probe#AuthRequired> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Authentication required (HTTP 401 or 403)"@en, "Authenticatie vereist (HTTP 401 of 403)"@nl.
<https://def.nde.nl/probe#RateLimited> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Rate limited (HTTP 429)"@en, "Rate-limiet (HTTP 429)"@nl.
<https://def.nde.nl/probe#ContentTypeMismatch> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Response Content-Type does not match the declared media type"@en, "Content-Type van respons komt niet overeen met het opgegeven mediatype"@nl.
<https://def.nde.nl/probe#ContentTypeMissing> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Response has no Content-Type header"@en, "Respons heeft geen Content-Type-header"@nl.
<https://def.nde.nl/probe#EmptyBody> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Response body is empty"@en, "Responsbody is leeg"@nl.
<https://def.nde.nl/probe#SparqlProbeFailed> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "SPARQL probe query failed"@en, "SPARQL-probequery mislukt"@nl.
<https://def.nde.nl/probe#RdfParseFailed> a <https://def.nde.nl/probe#ProbeOutcome>;
    <http://www.w3.org/2000/01/rdf-schema#label> "RDF data dump could not be parsed"@en, "RDF-databundel kon niet worden geparseerd"@nl.
